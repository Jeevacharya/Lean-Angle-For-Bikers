<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_primary"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:baselineAligned="false">

    <!-- LEFT COLUMN: Max Left + Left Calibrate Button -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <!-- Max Left Card (-ve) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg_left"
            android:padding="10dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◄ MAX LEFT"
                android:textColor="@color/neon_red"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/maxLeftText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0°"
                android:textColor="@color/text_white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- Left Calibrate Button -->
        <Button
            android:id="@+id/btnCalibrateLeft"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⌖ CALIBRATE"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_calibrate_bg" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Reset Max Button on Left Side -->
        <Button
            android:id="@+id/btnResetMaxLeft"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="@string/reset_max"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_reset_bg" />

    </LinearLayout>

    <!-- CENTER COLUMN: Motorcycle Animation Gauge + Central Digital Readout -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.2"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MOTO LEAN"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/sensorStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1-AXIS LATERAL SENSOR"
                android:textColor="@color/neon_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Big Lean Animation Gauge in the Middle -->
        <view
            class="com.motolean.app.LeanGaugeView"
            android:id="@+id/leanGaugeView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Direction Badge + Angle Number (No decimals!) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/directionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upright"
                android:textColor="@color/neon_green"
                android:background="@drawable/badge_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Huge Lean Angle (Integer without decimals) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/signGlyph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/neon_green"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:paddingEnd="2dp" />

                <TextView
                    android:id="@+id/angleNumberText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/text_white"
                    android:textSize="50sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="°"
                    android:textColor="@color/text_secondary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:paddingBottom="5dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lateralGText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- RIGHT COLUMN: Max Right + Right Calibrate Button + Reset Max -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp">

        <!-- Max Right Card (+ve) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg_right"
            android:padding="10dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX RIGHT ►"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/maxRightText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0°"
                android:textColor="@color/text_white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <!-- Right Calibrate Button -->
        <Button
            android:id="@+id/btnCalibrateRight"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⌖ CALIBRATE"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_calibrate_bg" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Reset Max Button -->
        <Button
            android:id="@+id/btnResetMax"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="@string/reset_max"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_reset_bg" />

    </LinearLayout>

</LinearLayout>
