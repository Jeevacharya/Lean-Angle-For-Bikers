<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp"
    android:gravity="center_horizontal">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/appTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MOTO LEAN"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- Theme Toggle Button (Light / Dark Mode) -->
        <ImageButton
            android:id="@+id/btnThemeToggle"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/btn_reset_bg"
            android:src="@drawable/ic_theme_sun"
            android:contentDescription="Toggle Light/Dark Theme"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Custom Canvas Gauge (Visual Motorcycle & Arc) -->
    <view
        class="com.motolean.app.LeanGaugeView"
        android:id="@+id/leanGaugeView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="180dp" />

    <!-- Digital Telemetry Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <!-- Direction Badge -->
        <TextView
            android:id="@+id/directionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upright"
            android:textColor="@color/neon_green"
            android:background="@drawable/badge_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- Huge Main Lean Angle Number -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/signGlyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/neon_green"
                android:textSize="44sp"
                android:textStyle="bold"
                android:paddingEnd="2dp" />

            <TextView
                android:id="@+id/angleNumberText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/text_white"
                android:textSize="64sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="°"
                android:textColor="@color/text_secondary"
                android:textSize="36sp"
                android:textStyle="bold"
                android:paddingBottom="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Peak Hold Cards (Max Left & Max Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <!-- Max Left Card (-ve) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg_left"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◄ MAX LEFT"
                android:textColor="@color/neon_red"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/maxLeftText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0°"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Reset Button -->
        <Button
            android:id="@+id/btnResetMax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="@string/reset_max"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/btn_reset_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:minHeight="48dp" />

        <!-- Max Right Card (+ve) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg_right"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX RIGHT ►"
                android:textColor="@color/neon_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/maxRightText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0°"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- SINGLE CALIBRATE BUTTON FOR PORTRAIT MODE -->
    <Button
        android:id="@+id/btnCalibrate"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/calibrate"
        android:textColor="@color/text_white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:background="@drawable/btn_calibrate_bg" />

</LinearLayout>
